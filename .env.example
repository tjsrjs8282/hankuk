# Copy to .env.local and fill in. Only GEMINI_API_KEY is read at runtime (/api/assistant,
# Vercel build only); without it the AI 도우미 answers from the built-in campus guide.
GEMINI_API_KEY=
# Optional override (default: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Asset tooling only (npm run assets:music) — never shipped.
ELEVENLABS_API_KEY=
