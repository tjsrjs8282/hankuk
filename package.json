{
  "name": "hankuk-remastered",
  "version": "2.0.0",
  "private": true,
  "description": "한국대학교 메인페이지 — the 2020 jQuery original, rebuilt from scratch with Astro and AI-generated campus media.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4350",
    "dev:vercel": "node scripts/run.mjs vercel astro dev --port 4350",
    "build": "astro build",
    "build:vercel": "node scripts/run.mjs vercel astro build",
    "preview": "astro preview --port 4351",
    "check": "astro check",
    "assets:fetch": "node scripts/fetch.mjs",
    "assets:images": "node scripts/images.mjs",
    "assets:media": "node scripts/media.mjs",
    "assets:music": "node scripts/music.mjs",
    "assets:og": "node scripts/og.mjs",
    "assets:font": "node scripts/font.mjs",
    "assets": "npm run assets:fetch && npm run assets:images && npm run assets:media && npm run assets:og",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "astro": "7.4.4",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "pretendard": "1.3.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/vercel": "11.0.17",
    "@types/node": "24.19.2",
    "puppeteer-core": "24.43.1",
    "sharp": "0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
