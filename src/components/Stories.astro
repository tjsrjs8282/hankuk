---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import TargetLink from "./TargetLink.astro";
import { stories } from "../data/site";
import { ui, t, type Lang } from "../i18n";

import admission from "../assets/photos/slide-admission.jpg";
import global from "../assets/photos/slide-global.jpg";
import ai from "../assets/photos/slide-ai-lab.jpg";
import library from "../assets/photos/slide-library.jpg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const images: Record<string, ImageMetadata> = { "slide-admission": admission, "slide-global": global, "slide-ai-lab": ai, "slide-library": library };
const label = lang === "ko" ? "주요 소식" : "Highlights";
---

<section class="tile t-story story" aria-roledescription="carousel" aria-label={label} data-slider>
  <div class="story__slides" data-slider-track aria-live="off">
    {
      stories.map((s, i) => (
        <div
          class:list={["story__slide", { "is-active": i === 0 }]}
          role="group"
          aria-roledescription={t(ui.slide, lang)}
          aria-label={`${i + 1} ${t(ui.of, lang)} ${stories.length}`}
          aria-hidden={i === 0 ? undefined : "true"}
          data-slide
        >
          <Picture
            src={images[s.image]}
            widths={[640, 960, 1280, 1800]}
            sizes="(min-width: 1100px) 75vw, 100vw"
            formats={["avif", "webp"]}
            alt=""
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : undefined}
            class="story__img"
          />
          <div class="story__shade" />
          <div class="story__body">
            <span class="chip story__tag">{t(s.tag, lang)}</span>
            <h2 class="story__title pre-line">{t(s.title, lang)}</h2>
            <p class="story__text">{t(s.text, lang)}</p>
            <TargetLink target={s.target} lang={lang} class="btn btn-light story__cta" tabindex={i === 0 ? undefined : "-1"}>
              {t(s.cta, lang)}
              <Icon name="arrow-right" class="arrow" />
            </TargetLink>
          </div>
        </div>
      ))
    }
  </div>

  <div class="story__controls">
    <button type="button" class="story__arrow" data-slider-prev aria-label={t(ui.prev, lang)}>
      <Icon name="chevron-left" size={20} />
    </button>
    <div class="story__dots">
      {
        stories.map((s, i) => (
          <button type="button" class:list={["story__dot", { "is-active": i === 0 }]} data-slider-dot={i} aria-label={`${i + 1}: ${t(s.tag, lang)}`} aria-current={i === 0 ? "true" : undefined}>
            <span class="story__dot-fill" />
          </button>
        ))
      }
    </div>
    <span class="story__count tabular" aria-hidden="true"><b data-slider-current>01</b> / {String(stories.length).padStart(2, "0")}</span>
    <button type="button" class="story__arrow" data-slider-next aria-label={t(ui.next, lang)}>
      <Icon name="chevron-right" size={20} />
    </button>
    <button type="button" class="story__arrow story__play" data-slider-toggle aria-pressed="false" data-label-pause={t(ui.pause, lang)} data-label-play={t(ui.play, lang)} aria-label={t(ui.pause, lang)}>
      <Icon name="pause" size={14} class="i-pause" />
      <Icon name="play" size={14} class="i-play" />
    </button>
  </div>
</section>

<style>
  .story {
    position: relative;
    overflow: hidden;
    background: var(--navy-900);
    color: #fff;
    min-height: 480px;
    touch-action: pan-y;
  }
  .story__slides,
  .story__slide {
    position: absolute;
    inset: 0;
  }
  .story__slide {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.9s var(--ease),
      visibility 0s 0.9s;
  }
  .story__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.9s var(--ease);
  }
  .story__slide :global(picture),
  .story__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .story__img {
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 7s linear;
  }
  .story__slide.is-active .story__img {
    transform: scale(1);
  }
  .story__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 15, 38, 0.82) 0%, rgba(5, 15, 38, 0.5) 40%, rgba(5, 15, 38, 0) 72%),
      linear-gradient(0deg, rgba(5, 15, 38, 0.65) 0%, rgba(5, 15, 38, 0) 40%);
  }
  .story__body {
    position: absolute;
    left: clamp(24px, 4vw, 56px);
    right: 24px;
    top: 50%;
    transform: translateY(-58%);
    max-width: 30rem;
  }
  .story__tag {
    background: var(--gold-400);
    color: var(--navy-950);
  }
  .story__title {
    margin-top: 16px;
    font-size: clamp(1.9rem, 1.2rem + 2.2vw, 3.1rem);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .story__text {
    margin-top: 14px;
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.86);
  }
  .story__cta {
    margin-top: 26px;
  }
  .story__slide.is-active .story__tag,
  .story__slide.is-active .story__title,
  .story__slide.is-active .story__text,
  .story__slide.is-active .story__cta {
    animation: story-up 0.9s var(--ease) both;
  }
  .story__slide.is-active .story__title {
    animation-delay: 0.08s;
  }
  .story__slide.is-active .story__text {
    animation-delay: 0.16s;
  }
  .story__slide.is-active .story__cta {
    animation-delay: 0.24s;
  }
  @keyframes story-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  .story__controls {
    position: absolute;
    left: clamp(24px, 4vw, 56px);
    bottom: 26px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .story__arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #fff;
    transition: background-color 0.2s, color 0.2s;
  }
  .story__arrow:hover {
    background: #fff;
    color: var(--navy-900);
  }
  .story__play .i-play {
    display: none;
  }
  .story__play[aria-pressed="true"] .i-play {
    display: block;
  }
  .story__play[aria-pressed="true"] .i-pause {
    display: none;
  }
  .story__dots {
    display: flex;
    gap: 6px;
  }
  .story__dot {
    position: relative;
    width: 34px;
    height: 24px;
  }
  .story__dot::before,
  .story__dot-fill {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    margin-top: -1.5px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.35);
  }
  .story__dot-fill {
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }
  .story__dot.is-active .story__dot-fill {
    animation: dot-fill var(--slide-ms, 6500ms) linear forwards;
  }
  .story__dot.is-done .story__dot-fill {
    transform: scaleX(1);
  }
  :global(.story.is-paused) .story__dot.is-active .story__dot-fill {
    animation-play-state: paused;
  }
  @keyframes dot-fill {
    to {
      transform: scaleX(1);
    }
  }
  .story__count {
    min-width: 54px;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.7);
  }
  .story__count b {
    color: #fff;
  }

  @media (max-width: 680px) {
    .story {
      min-height: 520px;
    }
    .story__shade {
      background: linear-gradient(0deg, rgba(5, 15, 38, 0.92) 0%, rgba(5, 15, 38, 0.45) 60%, rgba(5, 15, 38, 0.1) 100%);
    }
    .story__body {
      top: auto;
      bottom: 84px;
      transform: none;
    }
    .story__count {
      display: none;
    }
    .story__controls {
      gap: 6px;
      bottom: 20px;
    }
    .story__arrow {
      width: 40px;
      height: 40px;
    }
    .story__dot {
      width: 22px;
      height: 40px;
    }
    .story__body {
      bottom: 88px;
    }
  }
</style>
