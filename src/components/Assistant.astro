---
import Icon from "./Icon.astro";
import Mark from "../assets/brand/mark.svg";
import { guide, suggestions } from "../data/guide";
import { ui, t, type Lang } from "../i18n";

/**
 * 한국대 AI 도우미. On GitHub Pages it answers from the built-in campus guide
 * (src/data/guide.ts); on the Vercel build it asks Gemini, grounded in the same guide.
 */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const chips = suggestions.map((id) => guide.find((g) => g.id === id)!).filter(Boolean);
---

<button type="button" class="ai-fab" data-ai-open aria-haspopup="dialog" aria-label={lang === "ko" ? "AI 도우미 열기" : "Open the AI assistant"}>
  <Icon name="sparkle" size={22} />
  <span class="ai-fab__label">{lang === "ko" ? "AI 도우미" : "Ask AI"}</span>
</button>

<dialog class="ai" data-lenis-prevent data-ai aria-labelledby="ai-title">
  <div class="ai__in">
    <header class="ai__head">
      <span class="ai__avatar"><Mark width="26" height="26" /></span>
      <div class="ai__who">
        <h2 id="ai-title" class="ai__title">{lang === "ko" ? "한국대 AI 도우미" : "Hanguk AI assistant"}</h2>
        <p class="ai__status"><i></i><span data-ai-mode>{lang === "ko" ? "캠퍼스 안내서 기반" : "Answers from the campus guide"}</span></p>
      </div>
      <button type="button" class="icon-btn ai__close" data-close aria-label={t(ui.close, lang)}>
        <Icon name="close" />
      </button>
    </header>

    <div class="ai__log" data-lenis-prevent role="log" aria-live="polite" aria-relevant="additions" data-ai-log>
      <div class="msg msg--bot">
        <p>
          {lang === "ko" ? "안녕하세요! 입학 · 학사 · 장학 · 캠퍼스 생활에 대해 무엇이든 물어보세요." : "Hi! Ask me anything about admissions, academics, scholarships or campus life."}
        </p>
      </div>
    </div>

    <div class="ai__chips" data-ai-chips>
      {
        chips.map((c) => (
          <button type="button" class="ai__chip" data-ai-ask={t(c.q, lang)}>
            {t(c.q, lang)}
          </button>
        ))
      }
    </div>

    <form class="ai__form" data-ai-form>
      <label class="sr-only" for="ai-input">{lang === "ko" ? "질문 입력" : "Your question"}</label>
      <input id="ai-input" class="ai__input" name="q" type="text" maxlength="300" autocomplete="off" enterkeyhint="send" placeholder={lang === "ko" ? "예) 기숙사 신청은 언제야?" : "e.g. When is housing application?"} data-ai-input />
      <button type="submit" class="ai__send" aria-label={lang === "ko" ? "보내기" : "Send"}>
        <Icon name="send" size={20} />
      </button>
    </form>
    <p class="ai__foot">{lang === "ko" ? "가상의 대학 데모입니다 · 일정과 숫자도 가상이에요" : "Fictional university demo · dates and numbers are fictional"}</p>
  </div>
</dialog>

<style>
  .ai-fab {
    position: fixed;
    right: clamp(16px, 2.5vw, 28px);
    bottom: clamp(16px, 2.5vw, 28px);
    z-index: 70;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 56px;
    padding: 0 22px 0 18px;
    border-radius: 999px;
    background: linear-gradient(120deg, var(--navy-900) 0%, var(--blue-700) 100%);
    color: #fff;
    font-weight: 800;
    box-shadow:
      0 14px 30px -10px rgba(10, 27, 63, 0.7),
      inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s;
  }
  .ai-fab :global(svg) {
    color: var(--gold-400);
  }
  .ai-fab:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 36px -12px rgba(10, 27, 63, 0.8);
  }
  :global(html.ai-open) .ai-fab {
    opacity: 0;
    pointer-events: none;
  }

  /* Non-modal panel on desktop (the page stays usable), full screen on phones. */
  .ai {
    position: fixed;
    inset: auto clamp(16px, 2.5vw, 28px) clamp(16px, 2.5vw, 28px) auto;
    z-index: 80;
    width: min(400px, calc(100vw - 32px));
    height: min(640px, calc(100dvh - 32px));
    margin: 0;
  }
  .ai__in {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-l);
    background: #fff;
    box-shadow:
      0 30px 60px -20px rgba(5, 15, 38, 0.5),
      0 0 0 1px rgba(10, 27, 63, 0.08);
    overflow: hidden;
  }
  .ai__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 10px 14px 16px;
    background: linear-gradient(120deg, var(--navy-900) 0%, var(--blue-700) 100%);
    color: #fff;
  }
  .ai__avatar {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .ai__who {
    flex: 1;
    min-width: 0;
  }
  .ai__title {
    font-size: 1rem;
    font-weight: 800;
  }
  .ai__status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.75);
  }
  .ai__status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #34d399;
  }
  .ai__close {
    color: #fff;
  }
  .ai__close:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .ai__log {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 18px 16px 8px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--paper);
  }
  .ai__chips {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    overflow-x: auto;
    scrollbar-width: none;
    background: var(--paper);
    border-top: 1px solid var(--line);
  }
  .ai__chip {
    flex: none;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--navy-800);
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .ai__chip:hover {
    border-color: var(--navy-900);
    background: var(--blue-50);
  }
  .ai__form {
    display: flex;
    gap: 8px;
    padding: 10px 12px 6px;
    border-top: 1px solid var(--line);
  }
  .ai__input {
    flex: 1;
    min-width: 0;
    height: 46px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1.5px solid var(--line-strong);
    background: #fff;
    font-size: 1rem;
    transition: border-color 0.2s;
  }
  .ai__input:focus {
    outline: none;
    border-color: var(--blue-600);
  }
  .ai__send {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--blue-600);
    color: #fff;
    transition: background-color 0.2s;
  }
  .ai__send:hover {
    background: var(--blue-700);
  }
  .ai__foot {
    padding: 2px 12px 10px;
    text-align: center;
    font-size: 0.6875rem;
    color: var(--ink-400);
  }

  /* messages are created by scripts/assistant.ts */
  .ai__log :global(.msg) {
    max-width: 88%;
    padding: 11px 14px;
    border-radius: 16px;
    font-size: 0.9375rem;
    line-height: 1.6;
    white-space: pre-line;
    animation: msg-in 0.35s var(--ease);
  }
  .ai__log :global(.msg--bot) {
    align-self: flex-start;
    background: #fff;
    border-top-left-radius: 4px;
    box-shadow: var(--shadow-1);
  }
  .ai__log :global(.msg--me) {
    align-self: flex-end;
    background: var(--navy-900);
    color: #fff;
    border-top-right-radius: 4px;
  }
  .ai__log :global(.msg__links) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .ai__log :global(.msg__link) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--blue-50);
    color: var(--blue-700);
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .ai__log :global(.msg__link:hover) {
    background: var(--blue-100);
  }
  .ai__log :global(.msg__src) {
    display: block;
    margin-top: 8px;
    font-size: 0.6875rem;
    color: var(--ink-400);
  }
  .ai__log :global(.msg--typing) {
    display: inline-flex;
    gap: 4px;
    padding: 14px 16px;
  }
  .ai__log :global(.msg--typing i) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink-400);
    animation: typing 1.2s ease-in-out infinite;
  }
  .ai__log :global(.msg--typing i:nth-child(2)) {
    animation-delay: 0.15s;
  }
  .ai__log :global(.msg--typing i:nth-child(3)) {
    animation-delay: 0.3s;
  }
  @keyframes typing {
    0%,
    80%,
    100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    40% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }
  @keyframes msg-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @media (max-width: 640px) {
    .ai {
      inset: 0;
      width: 100vw;
      height: 100dvh;
      max-width: none;
      max-height: none;
    }
    .ai__in {
      border-radius: 0;
    }
    .ai-fab {
      height: 50px;
      padding: 0 18px 0 14px;
    }
  }
</style>
