---
import Logo from "./Logo.astro";
import { footerLinks, directions, contact } from "../data/site";
import { t, type Lang } from "../i18n";

/** 2020 footer, kept in spirit: links, address, contacts, copyright. */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <Logo lang={lang} tone="light" />
      <ul class="footer__links">
        {
          footerLinks.map((l, i) => (
            <li>
              <button type="button" data-demo class:list={{ strong: i === 1 }}>
                {t(l, lang)}
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer__body">
      <address class="footer__addr">
        <p>{t(directions.address, lang)}</p>
        <p>
          <span>{lang === "ko" ? "대표전화" : "Tel"} <b class="tabular">{contact.phone}</b></span>
          <span>FAX <b class="tabular">{contact.fax}</b></span>
          <span>{contact.email}</span>
        </p>
        <p class="footer__copy">
          <span>© 2026 HANGUK UNIVERSITY. ALL RIGHTS RESERVED.</span>
          <span>{lang === "ko" ? "사진 · 영상 · 음악은 AI로 생성되었습니다." : "Photos, video and music generated with AI."}</span>
        </p>
      </address>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy-950);
    color: rgba(255, 255, 255, 0.72);
    padding: 56px 0 40px;
    font-size: 0.875rem;
  }
  .footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 28px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
  }
  .footer__links li + li::before {
    content: "";
    display: inline-block;
    width: 1px;
    height: 11px;
    margin: 0 14px;
    background: rgba(255, 255, 255, 0.25);
  }
  .footer__links button {
    color: rgba(255, 255, 255, 0.78);
    transition: color 0.2s;
  }
  .footer__links button:hover {
    color: #fff;
  }
  .footer__links .strong {
    color: var(--gold-400);
    font-weight: 700;
  }
  .footer__body {
    padding-top: 28px;
  }
  .footer__addr {
    font-style: normal;
    display: grid;
    gap: 6px;
    line-height: 1.7;
  }
  .footer__addr p:nth-child(2) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }
  .footer__addr b {
    color: #fff;
    font-weight: 600;
  }
  .footer__copy {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 16px;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.58);
  }
</style>
