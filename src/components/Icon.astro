---
/**
 * Line icons drawn for this site (24×24, 1.75 stroke) — no icon font, no library.
 * The 2020 site used 22 separate PNG icons; these replace all of them.
 */
interface Props {
  name: keyof typeof paths;
  class?: string;
  size?: number;
  /** Passed through — this is how a parent's scoped styles (data-astro-cid-*) reach the <svg>. */
