---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import poster from "../assets/photos/reel-poster.jpg";
import type { Lang } from "../i18n";

/** 2020: a YouTube vlog in a colorbox → our own 30-second campus film (Higgsfield + ElevenLabs). */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<button type="button" class="tile t-film film" data-open-film aria-haspopup="dialog">
  <Picture src={poster} widths={[400, 700, 1000]} sizes="(min-width: 1100px) 25vw, (min-width: 681px) 50vw, 100vw" formats={["avif", "webp"]} alt="" loading="lazy" class="film__img" />
  <span class="film__shade"></span>
  <span class="film__play" aria-hidden="true"><Icon name="play" size={26} /></span>
  <span class="film__meta">
    <span class="film__kicker serif">Campus Film</span>
    <span class="film__title">{lang === "ko" ? "30초로 보는 한국대학교" : "Hanguk in 30 seconds"}</span>
    <span class="film__len tabular">0:30</span>
  </span>
</button>

<style>
  .film {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    color: #fff;
    min-height: 260px;
    text-align: left;
    background: var(--navy-900);
  }
  .film :global(picture),
  .film__img,
  .film__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .film__img {
    object-fit: cover;
    transition: transform 1s var(--ease);
  }
  .film:hover .film__img {
    transform: scale(1.06);
  }
  .film__shade {
    background: linear-gradient(0deg, rgba(5, 15, 38, 0.85) 0%, rgba(5, 15, 38, 0.15) 60%, rgba(5, 15, 38, 0.3) 100%);
    transition: background-color 0.3s;
  }
  .film:hover .film__shade {
    background-color: rgba(5, 15, 38, 0.2);
  }
  .film__play {
    position: absolute;
    left: 50%;
    top: 44%;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    padding-left: 4px;
    border-radius: 50%;
    background: rgba(5, 15, 38, 0.45);
    border: 1.5px solid rgba(255, 255, 255, 0.7);
    transform: translate(-50%, -50%);
    transition:
      transform 0.35s var(--ease),
      background-color 0.35s,
      color 0.35s;
  }
  .film__play::before {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    animation: ring 2.4s var(--ease) infinite;
  }
  @keyframes ring {
    from {
      transform: scale(0.85);
      opacity: 1;
    }
    to {
      transform: scale(1.35);
      opacity: 0;
    }
  }
  .film:hover .film__play {
    transform: translate(-50%, -50%) scale(1.08);
    background: #fff;
    color: var(--navy-900);
  }
  .film__meta {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 18px;
    display: grid;
  }
  .film__kicker {
    font-style: italic;
    color: var(--gold-400);
    font-size: 1rem;
  }
  .film__title {
    font-size: 1.125rem;
    font-weight: 800;
  }
  .film__len {
    position: absolute;
    right: 0;
    bottom: 2px;
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.45);
  }
</style>
