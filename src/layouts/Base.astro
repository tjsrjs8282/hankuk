---
import { Font } from "astro:assets";
import "../styles/global.css";
// Generated by scripts/font.mjs when Astro starts (Pretendard cut to the site's characters).
import siteFont from "../assets/fonts/pretendard-site.woff2?url";
import { withBase } from "../lib/paths";
import { ui, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Preload for the LCP image (hero still). */
  preload?: { srcset: string; sizes: string; type: string };
}

const { lang, title, description, preload } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ko = new URL(withBase("/"), Astro.site);
const en = new URL(withBase("/en/"), Astro.site);
const ogImage = new URL(withBase("og.jpg"), Astro.site);
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ko" href={ko} />
    <link rel="alternate" hreflang="en" href={en} />
    <link rel="alternate" hreflang="x-default" href={ko} />
    <meta name="theme-color" content="#0a1b3f" />

    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={withBase("favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("site.webmanifest")} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "ko" ? "ko_KR" : "en_US"} />
    <meta property="og:site_name" content={lang === "ko" ? "한국대학교" : "Hanguk University"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === "ko" ? "은행나무길 끝 한국대학교 본관과 '세계로 향하는 한국대학교' 문구" : "Hanguk University's clock-tower hall at the end of Ginkgo Road"} />
    <meta name="twitter:card" content="summary_large_image" />

    {preload && <link rel="preload" as="image" imagesrcset={preload.srcset} imagesizes={preload.sizes} type={preload.type} fetchpriority="high" />}
    <link rel="preload" as="font" type="font/woff2" href={siteFont} crossorigin />
    <Font cssVariable="--font-serif" />

    <script is:inline>
      // Before first paint: flag JS, restore the 글자크기 choice, decide on motion.
      (function () {
        var d = document.documentElement;
        d.classList.remove("no-js");
        d.classList.add("js");
        try {
          var s = parseFloat(localStorage.getItem("hk:font-scale"));
          if (s >= 0.9 && s <= 1.3) d.style.setProperty("--fs-scale", String(s));
        } catch (e) {}
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        d.classList.add(reduce ? "reduce-motion" : "js-motion");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(ui.skip, lang)}</a>
    <slot />
    <div class="toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>
